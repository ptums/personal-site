{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "trailingSlash": false,
  "redirects": [
    { "source": "/blog", "destination": "/words", "permanent": true },
    { "source": "/blog/post/:slug", "destination": "/words/:slug", "permanent": true }
  ]
}
