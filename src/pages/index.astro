---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";

const CONTACTS = [
  { id: 1, slug: "https://github.com/ptums", label: "Github" },
  {
    id: 2,
    slug: "https://www.linkedin.com/in/petertumulty",
    label: "LinkedIn",
  },
  { id: 3, slug: "mailto:peter@tumulty.me", label: "Email" },
];

// Projects shown on first load; the rest reveal in batches as the user scrolls
const INITIAL_PROJECTS = 3;

// A description is either one paragraph or labelled sections; **text** renders bold
type Project = {
  title: string;
  // Optional tag shown at the right of the title row, e.g. "Personal"
  label?: string;
  description: string | { label: string; text: string }[];
  tools: string[];
  links: { label: string; href: string }[];
};

// Split text on **markers**; odd-indexed parts are rendered as <strong>
const boldParts = (text: string) => text.split(/\*\*(.+?)\*\*/);

const PROJECTS: Project[] = [
  {
    title: "Legacy App Migration to a New Stack, Built with AI",
    label: "Personal",
    description:
      "A legacy photo-gallery app had **3 high-severity vulnerabilities** in its upload dependencies, **9 packages it used but never declared**, and failed to start on a clean install. I rebuilt it on a modern stack I had never used, with Claude as a partner, but made every design decision myself. I checked each result by hand, threw out two bad performance measurements, and confirmed deletes remove both the record and the stored file. Dependency checks now find **0** vulnerabilities, a fresh clone runs locally in **16 seconds** with **13 commands**, and compression cut CSS from **232 KB to 49 KB**.",
    tools: [
      "Angular",
      "ASP.NET Core",
      "Azure Cosmos DB",
      "Blob Storage",
      "Claude",
    ],
    links: [
      {
        label: "Source",
        href: "https://github.com/ptums/rachels-favorite-pets",
      },
      {
        label: "Baseline",
        href: "https://github.com/ptums/rachels-favorite-pets/blob/master/BASELINE.md",
      },
    ],
  },
  {
    title: "Agentic Removal of a Deprecated Feature",
    description:
      "A deprecated feature was still live in a production codebase that was **slowing teams down** with routine maintenance. I ran a multi-pass AI workflow: map every dependency, verify, send each scope question to a person, then delete. It caught multiple scope corrections the first estimate missed, and it kept files that a plain pattern-match would have wrongly removed. **300+ files** came out in **about half a day**, in a stack of pull requests that all passed CI.",
    tools: ["Agentic Workflows", "CI/CD", "Code Migration"],
    links: [],
  },
  {
    title: "AI Agent Skill for Design-System Migration",
    description:
      "Team owned **two dozen libraries** with **thousands of lines of code** that had to move to the latest UI design system before the end of the quarter. We were given an AI skill that updated one library at a time. I built a wrapper skill around it that put every library on its own branch, generated a verification guide for each one, and added quality gates before review. I then handed the complex skill to an agentic workflow to run through the whole list. Per-library effort dropped from **hours to near-zero**, and the full set was done in **about three weeks**.",
    tools: ["Agentic Workflows", "AI Agent Skills", "Code Migration"],
    links: [],
  },
  {
    title: "Multi-Ticket Lint Cleanup Pipeline",
    description:
      "Ran a multi-phase agentic workflow (spec, plan, implement, test, review, PR) to resolve dozens of linting violations across roughly ten interconnected projects ahead of a strict compliance deadline. Parallel implementation agents handled independently scoped work items, with independent verification so a shared-state regression never reached review. Result: a handful of clean, CI-passing PRs opened in about a day and merged the next, with every caveat disclosed.",
    tools: ["Agentic Workflows", "Parallel Agents", "CI/CD"],
    links: [],
  },
  {
    title: "Law Firm Web Platform: Monolith to Headless",
    description:
      "Law firm's WordPress site was bloated, its home page **graded D on GTmetrix**, and it kept **crashing due to hosting limits.** I split the front end from the content server, put each on its own host, and set up monitoring and outage alerts on both. I also automated deploys, abd wrote a microservice for complex content delivery. With this new flexibility I was able to add  email marketing and a CRM integrations, which grew a new mailing list to 40+ subscribers in the first year. The home page grade went from **D to A**, uptime reached **99%**, and **hosting costs fell about 90%**, which funded the new marketing integrations.",
    tools: [
      "Digital Ocean",
      "Next.js",
      "Node.js",
      "Vercel",
      "WordPress GraphQL",
      "MySQL",
      "GitHub Actions",
      "Mailchimp",
      "HubSpot",
    ],
    links: [{ label: "Site", href: "https://scarincihollenbeck.com" }],
  },
  {
    title: "Asbury Park High School Hall of Fame: Redesign & Migration",
    description:
      "A high school Hall of Fame site had to be hand-coded page by page: adding one inductee meant editing up to **107 files**, because the navigation was copied into every page. It also ran on plain HTTP, had no mobile layout, and still showed a four-year-old announcement. I scoped it, planned three phases, and rebuilt it with a member directory filterable by year, ceremony photo galleries, event and donation pages, and contact and nomination forms. All content lives in one small data file that generates every page, so there is no database to host or maintain. Adding an inductee now takes **1 file**, accessibility rose from **53 to 96**, SEO from **82 to 100**, requires no hosting costs, and the site runs on HTTPS.",
    tools: ["Next.js", "Cloudinary", "Vercel", "Accessibility", "SEO"],
    links: [
      {
        label: "Baseline",
        href: "https://github.com/aphshf/aphshalloffame.com/blob/main/BASELINE.md",
      },
      {
        label: "Results",
        href: "https://github.com/aphshf/aphshalloffame.com/blob/main/RESULTS.md",
      },
    ],
  },
  {
    title: "Unleashed Potential: Headless CMS Rebuild",
    description:
      "Defined the roadmap and timeline for a site redesign, then built it on a headless CMS with sections for podcasts, interviews, blog posts, and YouTube videos, so the owner could publish her own marketing content. Set the keyword and technical SEO strategy and set up analytics and search indexing. Rebuilding on free-tier hosting eliminated her $20-a-month Wix cost, leaving only an $8-a-year domain.",
    tools: ["Next.js", "TypeScript", "Contentful", "SEO"],
    links: [],
  },
  {
    title: "CubbieKit: Shipping Label Automation",
    description:
      "Designed the backend solution to a shipping label problem for a Shopify store and owned it as lead engineer, tracking work in Linear with twice-weekly standups. Built a Node.js server that queries Shopify through GraphQL and creates labels through Shippo, deployed it to Heroku, and tested it against the live store. Worked with customer service to automate return labels using sample orders.",
    tools: ["Node.js", "Shopify GraphQL", "Shippo", "Heroku"],
    links: [],
  },
];
---

<Layout transparent>
  <div
    class="flex flex-col items-start lg:flex-row w-full pl-3 pr-4 mt-2 mb-8 gap-8 lg:gap-0 lg:gap-x-[5%]"
    style="min-height: 80vh"
  >
    <div
      class="w-full max-w-xs lg:w-[30%] lg:max-w-none lg:shrink-0 fade-in-up"
    >
      <img
        src="/images/peter-2023.webp"
        alt="Peter Tumulty"
        width="625"
        height="625"
        class="shadow-lg rounded-lg w-full h-auto aspect-square object-cover"
      />
    </div>

    <div
      class="w-full lg:w-[65%] bg-white border rounded-lg p-6 shadow-sm fade-in-up-delay-1"
    >
      <div
        class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-1"
      >
        <h1
          style="letter-spacing: 8px"
          class="text-4xl text-emerald-800 tracking-wider font-bold"
        >
          Peter F. Tumulty
        </h1>
        <Nav pathname={Astro.url.pathname} />
      </div>
      <h2
        class="m-0 text-emerald-500 font-bold mb-8 playfair-display text-base lg:whitespace-nowrap"
        style="letter-spacing: 2px"
      >
        Software Engineer | AI Enablement &amp; Modernization
      </h2>

      <div class="mb-8">
        <p class="font-semibold text-lg text-emerald-800">Connect with me</p>
        <ul class="mt-2 flex flex-row flex-wrap">
          {
            CONTACTS.map((contact) => (
              <li>
                <a
                  class="text-emerald-800 mr-4 text-sm underline"
                  href={contact.slug}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {contact.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="text-base mb-8 text-emerald-800 font-normal">
        I'm a software engineer focused on outcomes over outputs, with a focus
        on automation and cloud. I use AI to modernize legacy code, stacks, and
        workflows, guided by implementation strategy and system design. The goal
        is to cut engineering effort and technical costs while building products
        that scale, stay maintainable, and cost less to run. Below is work I can
        show, with the results.
      </p>

      <hr class="border-stone-200 mb-8" />

      <div class="fade-in-up-delay-2">
        <p class="font-semibold text-lg text-emerald-800 mb-4">Projects</p>
        <div
          data-project-scroller
          class="max-h-[70vh] lg:max-h-[640px] overflow-y-auto overscroll-contain px-1 pb-2 -mx-1"
        >
          <ol class="flex flex-col">
            {
              PROJECTS.map((project, i) => (
                <li
                  class={`flex flex-col items-center opacity-0 ${i >= INITIAL_PROJECTS ? "hidden" : ""}`}
                  data-project
                >
                  {i > 0 && (
                    <span class="w-0.5 h-8 bg-stone-200" aria-hidden="true" />
                  )}
                  <article class="w-full bg-white border-[0.5px] border-stone-200 rounded-lg p-4 shadow-md">
                    <div class="flex items-start justify-between gap-3 mb-1.5">
                      <h2 class="font-semibold text-base text-emerald-800 tracking-tight">
                        {project.title}
                      </h2>
                      {project.label && (
                        <span class="shrink-0 text-xs font-semibold text-stone-500 bg-stone-100 border-[0.5px] border-stone-200 rounded-full px-2 py-0.5">
                          {project.label}
                        </span>
                      )}
                    </div>
                    {typeof project.description === "string" ? (
                      <p class="text-sm text-emerald-800 leading-relaxed font-normal mb-3">
                        {boldParts(project.description).map((part, j) =>
                          j % 2 === 1 ? <strong>{part}</strong> : part,
                        )}
                      </p>
                    ) : (
                      <div class="flex flex-col gap-1.5 mb-3">
                        {project.description.map((section) => (
                          <p class="text-sm text-emerald-800 leading-relaxed font-normal">
                            <span class="font-semibold">{section.label}:</span>{" "}
                            {boldParts(section.text).map((part, j) =>
                              j % 2 === 1 ? <strong>{part}</strong> : part,
                            )}
                          </p>
                        ))}
                      </div>
                    )}
                    <p class="text-sm text-emerald-500 font-semibold">
                      {project.tools.join(" · ")}
                      {project.links.length > 0 && (
                        <>
                          <span
                            class="mx-2 text-emerald-300"
                            aria-hidden="true"
                          >
                            |
                          </span>
                          {project.links.map((link) => (
                            <a
                              href={link.href}
                              class="text-emerald-800 underline mr-3"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {link.label}
                            </a>
                          ))}
                        </>
                      )}
                    </p>
                  </article>
                </li>
              ))
            }
          </ol>
          <div data-project-sentinel class="h-px" aria-hidden="true"></div>
        </div>
        <noscript>
          <style>
            [data-project] {
              display: flex !important;
              opacity: 1 !important;
            }
          </style>
        </noscript>
      </div>
    </div>
  </div>
</Layout>

<script>
  const BATCH_SIZE = 3;
  const scroller = document.querySelector("[data-project-scroller]");
  const sentinel = document.querySelector("[data-project-sentinel]");
  const projects = Array.from(
    document.querySelectorAll<HTMLElement>("[data-project]"),
  );
  const queue = projects.filter((item) => item.classList.contains("hidden"));

  function show(item: HTMLElement, delay = 0) {
    item.style.animationDelay = `${delay}s`;
    item.classList.remove("opacity-0");
    item.classList.add("fade-in-up");
  }

  if (!("IntersectionObserver" in window)) {
    projects.forEach((item) => {
      item.classList.remove("hidden");
      show(item);
    });
  } else {
    // Fade each card in as it scrolls into view
    const fadeObserver = new IntersectionObserver(
      (entries) => {
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, i) => {
            show(entry.target as HTMLElement, i * 0.15);
            fadeObserver.unobserve(entry.target);
          });
      },
      { root: scroller, threshold: 0.15 },
    );
    projects.forEach((item) => fadeObserver.observe(item));

    // Unhide the next batch of cards when the end of the list nears the viewport
    if (sentinel && queue.length > 0) {
      const loadObserver = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting) return;
          queue
            .splice(0, BATCH_SIZE)
            .forEach((item) => item.classList.remove("hidden"));
          loadObserver.unobserve(sentinel);
          if (queue.length === 0) {
            loadObserver.disconnect();
            sentinel.remove();
          } else {
            // Re-observing fires again immediately if the sentinel is still on screen
            loadObserver.observe(sentinel);
          }
        },
        { root: scroller, rootMargin: "0px 0px 100px 0px" },
      );
      loadObserver.observe(sentinel);
    }
  }
</script>
