---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";

const CONTACTS = [
  { id: 1, slug: "https://github.com/ptums", label: "Github" },
  { id: 2, slug: "https://www.linkedin.com/in/petertumulty", label: "LinkedIn" },
  { id: 3, slug: "mailto:peter@tumulty.me", label: "Email" },
];

// TODO: replace placeholder projects with real content
const PROJECTS = [
  {
    title: "Legacy App Migration to a New Stack, Built with AI",
    description:
      "Migrated a legacy photo-gallery app to Angular, ASP.NET Core, Azure Cosmos DB, and Blob Storage, a stack I hadn't used before, with Claude as a working partner. I made the design decisions and verified every claim myself. Response compression alone cut CSS from 232 KB to 49 KB over the wire, and a fresh clone runs in 16 seconds with 13 commands. The README states what was and wasn't measured.",
    tools: ["Angular", "ASP.NET Core", "Azure Cosmos DB"],
    links: [
      { label: "Live", href: "#" },
      { label: "Source", href: "#" },
    ],
  },
  {
    title: "Agentic Removal of a Deprecated Feature",
    description:
      "Removed a deprecated, still-live feature from a production codebase using a multi-pass agentic workflow: map dependencies, verify, escalate scope questions, then execute. The initial scope undercounted the real dependency graph, and the workflow surfaced multiple corrections instead of guessing. Result: 300+ files removed in about half a day across a stack of CI-passing pull requests.",
    tools: ["Agentic Workflows", "CI/CD", "Code Migration"],
    links: [],
  },
  {
    title: "AI Agent Skill for Design-System Migration",
    description:
      "Built a custom AI agent skill, using spec-driven development, to run a design-system migration end to end per library: branch creation, automated code migration, generated verification guides, and quality gates. Per-library effort dropped from hours of manual work to near-zero, covering two dozen libraries in about three weeks.",
    tools: ["Spec-Driven Development", "AI Agent Skills", "Code Migration"],
    links: [],
  },
  {
    title: "Asbury Park High School Hall of Fame: Redesign & Migration",
    description:
      "Defined the scope, three-phase delivery plan, and timeline for a full redesign, then built it: a mobile-responsive site with a member directory filterable by year, a donation page, an event page with printable invitation and advertisement forms, and past ceremony photo pages. Moved it from static HTML/CSS/JS to Next.js and MongoDB on new hosting with SSL, with ADA compliance and basic SEO covered.",
    tools: ["Next.js", "MongoDB", "ADA", "SEO"],
    links: [],
  },
  {
    title: "Unleashed Potential: Headless CMS Rebuild",
    description:
      "Defined the roadmap and timeline for a site redesign, then built it on a headless CMS with sections for podcasts, interviews, blog posts, and YouTube videos, so the owner could publish her own marketing content. Set the keyword and technical SEO strategy and set up analytics and search indexing. Rebuilding on free-tier hosting eliminated her $20-a-month Wix cost, leaving only an $8-a-year domain.",
    tools: ["Next.js", "TypeScript", "Contentful", "SEO"],
    links: [],
  },
];
---

<Layout transparent>
  <div
    class="flex flex-col items-start lg:flex-row w-full pl-3 pr-4 mt-2 mb-8 gap-8 lg:gap-0 lg:gap-x-[5%]"
    style="min-height: 80vh"
  >
    <div class="w-full max-w-xs lg:w-[30%] lg:max-w-none lg:shrink-0 fade-in-up">
      <img
        src="/images/peter-2023.webp"
        alt="Peter Tumulty"
        width="625"
        height="625"
        class="shadow-lg rounded-lg w-full h-auto aspect-square object-cover"
      />
    </div>

    <div class="w-full lg:w-[65%] bg-white border rounded-lg p-6 shadow-sm fade-in-up-delay-1">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-1">
        <h1
          style="letter-spacing: 8px"
          class="text-4xl text-emerald-800 tracking-wider font-bold"
        >
          Peter F. Tumulty
        </h1>
        <Nav pathname={Astro.url.pathname} />
      </div>
      <h2
        class="m-0 text-emerald-500 font-bold mb-8 playfair-display text-base lg:whitespace-nowrap"
        style="letter-spacing: 2px"
      >
        Software Engineer | AI Enablement &amp; Modernization
      </h2>

      <div class="mb-8">
        <p class="font-semibold text-lg text-emerald-800">Connect with me</p>
        <ul class="mt-2 flex flex-row flex-wrap">
          {CONTACTS.map((contact) => (
            <li>
              <a
                class="text-emerald-800 mr-4 text-sm underline"
                href={contact.slug}
                target="_blank"
                rel="noopener noreferrer"
              >
                {contact.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <p class="text-base mb-8 text-emerald-800 font-normal">
        I'm a software engineer focused on AI enablement and modernization:
        moving legacy code, stacks, and workflows onto modern ones, with AI
        doing the heavy lifting and a person checking the work. I care most
        about the checking. Anyone can generate a migration; the value is in
        catching the wrong measurement, the missed dependency, and the claim
        that doesn't hold up. Below is work I can show, plus what I learned
        doing it.
      </p>

      <hr class="border-stone-200 mb-8" />

      <div class="fade-in-up-delay-2">
        <p class="font-semibold text-lg text-emerald-800 mb-4">Projects</p>
        <ol class="flex flex-col">
          {PROJECTS.map((project, i) => (
            <li class="flex flex-col items-center">
              {i > 0 && <span class="w-0.5 h-8 bg-stone-200" aria-hidden="true" />}
              <article class="w-full bg-white border-[0.5px] border-stone-200 rounded-lg p-4 shadow-md">
                <h2 class="font-semibold text-base text-emerald-800 tracking-tight mb-1.5">
                  {project.title}
                </h2>
                <p class="text-sm text-emerald-800 leading-relaxed font-normal mb-3">
                  {project.description}
                </p>
                <p class="text-sm text-emerald-500 font-semibold">
                  {project.tools.join(" · ")}
                  {project.links.length > 0 && (
                    <>
                      <span class="mx-2 text-emerald-300" aria-hidden="true">|</span>
                      {project.links.map((link) => (
                        <a
                          href={link.href}
                          class="text-emerald-800 underline mr-3"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {link.label}
                        </a>
                      ))}
                    </>
                  )}
                </p>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</Layout>
