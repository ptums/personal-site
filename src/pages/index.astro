---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import photo from "../assets/peter-2023.webp";
import { BOOKING_URL, PERSON } from "../data/site";

const CONTACTS = [
  { id: 1, slug: "https://github.com/ptums", label: "Github" },
  {
    id: 2,
    slug: "https://www.linkedin.com/in/petertumulty/",
    label: "LinkedIn",
  },
];

// A description is either one paragraph or labelled sections; **text** renders bold
type Project = {
  title: string;
  // Optional tag shown at the right of the title row, e.g. "Personal"
  label?: string;
  description: string | { label: string; text: string }[];
  tools: string[];
  links: { label: string; href: string }[];
  // Slug of the matching page under /work, if there is a case study
  caseStudy?: string;
};

// Split text on **markers**; odd-indexed parts are rendered as <strong>
const boldParts = (text: string) => text.split(/\*\*(.+?)\*\*/);

const PROJECTS: Project[] = [
  {
    title: "Legacy App Migration to a New Stack, Built with AI",
    label: "Personal",
    description:
      "Took an educational **photo-gallery app designed 10+ years ago** and rebuilt it on a modern stack I had never used, with Claude as a partner. That app had been archived and no major updates since 2015. When it first ran it had **3 high-severity vulnerabilities** in its upload dependencies, 9 packages it used but never listed in dependencies, and **failed to start on a clean install.** I checked each result by hand, threw out two bad performance measurements, and confirmed deletes remove both the record and the stored file.  Dependency checks now find 0 vulnerabilities, a fresh clone **runs locally in 16 seconds with 13 commands**, and compression **cut CSS from 232 KB to 49 KB.**",
    tools: [
      "Angular",
      "ASP.NET Core",
      "Azure Cosmos DB",
      "Blob Storage",
      "Claude",
    ],
    links: [
      {
        label: "Source",
        href: "https://github.com/ptums/rachels-favorite-pets",
      },
      {
        label: "Baseline",
        href: "https://github.com/ptums/rachels-favorite-pets/blob/master/BASELINE.md",
      },
    ],
  },
  {
    title: "AI-Assisted Migrations at Scale",
    description:
      "Between 2024 and 2025 our team's workspace needed several platform-level updates, and until they were done we couldn't release new features. The  timing was bad: we were also slated for a massive feature update before the end of the year. I  presented a plan to my manager and our staff engineer to let me automate the updates with agentic workflows and custom AI skills, so the team could stay on the feature work. I finished each update 3 to 6 weeks ahead of schedule, with minimal assistance from the team beyond reviewing PRs.",
    tools: ["Agentic Workflows", "Parallel Agents", "Agent Skills", "CI/CD"],
    links: [],
  },
  {
    title: "Law Firm Web Platform: Monolith to Headless",
    description:
      "A law firm's WordPress site was bloated, its home page **graded D on GTmetrix**, and it kept **crashing due to hosting limits.** I split the front end from the content server, put each on its own host, and set up monitoring and outage alerts on both. I also automated deploys and wrote a microservice for complex content delivery. With this new flexibility I was able to add email marketing and a CRM integration, which grew a new mailing list to 40+ subscribers in the first year. The home page grade went from **D to A**, uptime reached **99%**, and **hosting costs fell about 90%**, which funded the new marketing integrations.",
    tools: [
      "Digital Ocean",
      "Next.js",
      "Node.js",
      "Vercel",
      "WordPress GraphQL",
      "MySQL",
      "GitHub Actions",
      "Mailchimp",
      "HubSpot",
    ],
    links: [{ label: "Site", href: "https://scarincihollenbeck.com" }],
  },
  {
    title: "Asbury Park High School Hall of Fame: Redesign & Migration",
    description:
      "A non-profit high school Hall of Fame site had to be hand-coded page by page: adding one inductee meant editing up to **107 files**, because the navigation was copied into every page. It also ran on plain HTTP, had no mobile layout, and still showed a four-year-old announcement. I scoped it, planned three phases, and rebuilt it with a member directory filterable by year, ceremony photo galleries, event and donation pages, and contact and nomination forms. All content lives in one small data file that generates every page, so there is no database to host or maintain. Adding an inductee now takes **1 file**, accessibility rose from **53 to 96**, SEO from **82 to 100**, requires no hosting costs, and the site runs on HTTPS.",
    tools: ["Next.js", "Cloudinary", "Vercel", "Accessibility", "SEO"],
    links: [
      {
        label: "Baseline",
        href: "https://github.com/aphshf/aphshalloffame.com/blob/main/BASELINE.md",
      },
      {
        label: "Results",
        href: "https://github.com/aphshf/aphshalloffame.com/blob/main/RESULTS.md",
      },
    ],
    caseStudy: "hall-of-fame-rebuild",
  },
  {
    title: "Unleashed Potential: Headless CMS Rebuild",
    description:
      "A life coach paid $20 a month for a Wix site and wanted to publish her own podcasts, interviews, and posts. I rebuilt it on a headless CMS so she can do that herself, then changed every content page from rendering on each visit to prebuilt pages, so the site keeps serving even if the CMS goes down. A later audit found a 3.6 MB hero photo and 150 known vulnerabilities, and I fixed both. Hosting fell from **$240 a year to $8**, Lighthouse performance rose from **73 to 88**, and known runtime vulnerabilities went from **150 to 0**.",
    tools: ["Next.js", "TypeScript", "Contentful CMS", "SEO"],
    links: [
      {
        label: "Baseline",
        href: "https://github.com/UnleashedPotentialLifeCoaching/unleashedpotentiallifecoaching-web/blob/main/BASELINE.md",
      },
      {
        label: "Results",
        href: "https://github.com/UnleashedPotentialLifeCoaching/unleashedpotentiallifecoaching-web/blob/main/MIGRATION-RESULTS.md",
      },
    ],
  },
  {
    title: "CubbieKit: Shipping Label Automation",
    description:
      "Shopify store had a problem creating shipping labels for its orders. I designed the backend fix and led the build as lead engineer, running twice-weekly standups and tracking work in Linear. The new service reads orders from the store and creates labels automatically, and I tested it against the live store before launch. I then worked with customer service to automate return labels too, testing with sample orders. Labels for orders and returns are now created automatically, with no manual step.",
    tools: ["Node.js", "Shopify GraphQL", "Shippo", "Heroku", "Linear"],
    links: [],
  },
];
---

<Layout
  title={`${PERSON.name} | ${PERSON.jobTitle}`}
  description={PERSON.description}
>
  <div
    class="flex flex-col items-start lg:flex-row w-full pl-3 pr-4 mt-2 mb-8 gap-8 lg:gap-0 lg:gap-x-[5%]"
    style="min-height: 80vh"
  >
    <div
      class="w-full max-w-xs lg:w-[30%] lg:max-w-none lg:shrink-0 fade-in-up"
    >
      <!-- Astro makes a 340px and the original 625px version; the browser picks by screen -->
      <Image
        src={photo}
        alt="Peter Tumulty"
        widths={[340, 625]}
        sizes="(min-width: 1024px) 340px, 320px"
        loading="eager"
        class="shadow-lg rounded-lg w-full h-auto aspect-square object-cover"
      />
    </div>

    <div
      class="w-full lg:w-[65%] bg-white border rounded-lg p-6 shadow-sm fade-in-up-delay-1"
    >
      <div
        class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-1"
      >
        <h1
          style="letter-spacing: 8px"
          class="text-4xl text-emerald-800 tracking-wider font-bold"
        >
          Peter F. Tumulty
        </h1>
      </div>
      <h2
        class="m-0 text-emerald-700 font-bold mb-8 playfair-display text-base"
        style="letter-spacing: 2px"
      >
        AI-Driven Technical Product Management &amp; Engineering
      </h2>

      <div class="mb-8">
        <h3 class="font-semibold text-lg text-emerald-800">Connect with me</h3>
        <ul class="mt-2 flex flex-row flex-wrap">
          {
            CONTACTS.map((contact) => (
              <li>
                <a
                  class="text-emerald-800 mr-4 text-sm underline"
                  href={contact.slug}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {contact.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
          {
            /* Built by the script in Header.astro so the address isn't in the HTML */
          }
          <li>
            <a
              class="text-emerald-800 mr-4 text-sm underline"
              data-email-user="peter"
              data-email-domain="tumulty.me"
              hidden>Email</a
            >
            <noscript>
              <span class="text-emerald-800 text-sm"
                >peter at tumulty dot me</span
              >
            </noscript>
          </li>
          <li>
            <a
              class="text-emerald-800 mr-4 text-sm underline"
              href={BOOKING_URL}
              target="_blank"
              rel="noopener noreferrer"
              >Book an intro call<span class="sr-only">
                (opens in a new tab)</span
              ></a
            >
          </li>
        </ul>
      </div>

      <p class="text-base mb-2 text-emerald-800 font-normal">
        Hello, I'm Peter allow me to introduce myself. I am a technologist above
        all else. My experience whether personal or professional has lead me to
        touch all sorts of areas of tech. I've done some help desk work; setting
        up computers and printers. I've done some IoT work and networking. I've
        written programs that analyze complex data. I've even trained some AI
        models.
      </p>
      <p class="text-base mb-8 text-emerald-800 font-normal">
        However, most of my experience lies in full-stack web development. I've
        built everything from user experiences that reach tens of thousands of
        people a month to interconnected systems that automate processes, and
        deliver complex content. The purpose of this site is to share the
        outcomes of projects I've had best to time working on.
      </p>
      <hr class="border-stone-200 mb-8" />

      <div class="fade-in-up-delay-2">
        <h3
          id="projects-heading"
          class="font-semibold text-lg text-emerald-800 mb-4"
        >
          Projects
        </h3>
        <!-- All cards are in the page; the box is focusable so it can be scrolled with arrow keys.
             "relative" keeps the absolutely positioned sr-only link text inside the box; without it
             that text escaped to its spot far down the list and stretched the page below the footer. -->
        <div
          data-project-scroller
          tabindex="0"
          role="region"
          aria-labelledby="projects-heading"
          class="relative max-h-[70vh] lg:max-h-[640px] overflow-y-auto overscroll-contain px-1 pb-2 -mx-1"
        >
          <ol class="flex flex-col">
            {
              PROJECTS.map((project, i) => (
                <li class="flex flex-col items-center opacity-0" data-project>
                  {i > 0 && (
                    <span class="w-0.5 h-8 bg-stone-200" aria-hidden="true" />
                  )}
                  <article class="w-full bg-white border-[0.5px] border-stone-200 rounded-lg p-4 shadow-md">
                    <div class="flex items-start justify-between gap-3 mb-1.5">
                      <h4 class="font-semibold text-base text-emerald-800 tracking-tight">
                        {project.title}
                      </h4>
                      {project.label && (
                        <span class="shrink-0 text-xs font-semibold text-stone-600 bg-stone-100 border-[0.5px] border-stone-200 rounded-full px-2 py-0.5">
                          {project.label}
                        </span>
                      )}
                    </div>
                    {typeof project.description === "string" ? (
                      <p class="text-sm text-emerald-800 leading-relaxed font-normal mb-3">
                        {boldParts(project.description).map((part, j) =>
                          j % 2 === 1 ? <strong>{part}</strong> : part,
                        )}
                      </p>
                    ) : (
                      <div class="flex flex-col gap-1.5 mb-3">
                        {project.description.map((section) => (
                          <p class="text-sm text-emerald-800 leading-relaxed font-normal">
                            <span class="font-semibold">{section.label}:</span>{" "}
                            {boldParts(section.text).map((part, j) =>
                              j % 2 === 1 ? <strong>{part}</strong> : part,
                            )}
                          </p>
                        ))}
                      </div>
                    )}
                    <p class="text-sm text-emerald-700 font-semibold">
                      {project.tools.join(" · ")}
                      {(project.links.length > 0 || project.caseStudy) && (
                        <>
                          <span
                            class="mx-2 text-emerald-300"
                            aria-hidden="true"
                          >
                            |
                          </span>
                          {project.caseStudy && (
                            <a
                              href={`/work/${project.caseStudy}`}
                              class="text-emerald-800 underline mr-3"
                            >
                              Case study
                              <span class="sr-only">: {project.title}</span>
                            </a>
                          )}
                          {project.links.map((link) => (
                            <a
                              href={link.href}
                              class="text-emerald-800 underline mr-3"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {link.label}
                              <span class="sr-only"> (opens in a new tab)</span>
                            </a>
                          ))}
                        </>
                      )}
                    </p>
                  </article>
                </li>
              ))
            }
          </ol>
        </div>
        <noscript>
          <style>
            [data-project] {
              opacity: 1 !important;
            }
          </style>
        </noscript>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Every card is in the page from the start; each one fades in as it scrolls into view
  const scroller = document.querySelector("[data-project-scroller]");
  const projects = Array.from(
    document.querySelectorAll<HTMLElement>("[data-project]"),
  );

  function show(item: HTMLElement, delay = 0) {
    item.style.animationDelay = `${delay}s`;
    item.classList.remove("opacity-0");
    item.classList.add("fade-in-up");
  }

  if (!("IntersectionObserver" in window)) {
    projects.forEach((item) => show(item));
  } else {
    const fadeObserver = new IntersectionObserver(
      (entries) => {
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, i) => {
            show(entry.target as HTMLElement, i * 0.15);
            fadeObserver.unobserve(entry.target);
          });
      },
      { root: scroller, threshold: 0.15 },
    );
    projects.forEach((item) => fadeObserver.observe(item));
  }
</script>
