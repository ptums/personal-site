---
import Layout from "../layouts/Layout.astro";
import testimonials from "../../db/testimonials.json";

const sorted = [...testimonials].sort((a, b) => a.order - b.order);
---

<Layout
  title="Testimonials | Peter Tumulty"
  description="What clients and colleagues say about working with Peter Tumulty."
>
  <div class="w-full pl-3 pr-4 mt-2 mb-8">
    <div
      class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-8"
    >
      <!-- Tighter letter-spacing below 640px so the heading fits at 320px -->
      <h1
        class="text-4xl text-emerald-800 tracking-[3px] sm:tracking-[8px] font-bold"
      >
        Testimonials
      </h1>
    </div>
    <ul class="flex flex-col w-full">
      {sorted.map((testimonial, index) => (
        <li
          class="bg-white border-[0.5px] border-stone-200 rounded-lg shadow-md mb-6 last:mb-0 p-4 fade-in-up"
          style={`animation-delay: ${index * 0.15}s`}
        >
          <blockquote class="text-sm text-emerald-800 playfair-display mb-4">
            “{testimonial.statement}”
          </blockquote>
          <p class="text-xl text-emerald-700 font-semibold">{testimonial.name}</p>
          <p class="text-sm text-stone-600 font-semibold playfair-display">
            {testimonial.company}
          </p>
        </li>
      ))}
    </ul>
  </div>
</Layout>
