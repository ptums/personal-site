---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import Nav from "../../components/Nav.astro";

const posts = await getCollection("blog");
const sorted = posts.sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
---

<Layout
  title="Blog | Peter Tumulty Senior Software Engineer"
  description="Technical writing on web development, JavaScript, testing, and software engineering best practices."
>
  <div class="w-full pl-3 pr-4 mt-2 mb-8">
    <div
      class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-8"
    >
      <h1
        style="letter-spacing: 8px"
        class="text-4xl text-emerald-800 tracking-wider font-bold"
      >
        Blog
      </h1>
      <Nav pathname={Astro.url.pathname} />
    </div>
    <div class="flex flex-col w-full">
      {sorted.map((post, index) => (
        <PostCard
          title={post.data.title}
          tagLine={post.data.tagLine}
          description={post.data.description}
          slug={post.slug}
          index={index}
        />
      ))}
    </div>
  </div>
</Layout>
