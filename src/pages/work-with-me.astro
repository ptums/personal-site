---
import Layout from "../layouts/Layout.astro";
import testimonials from "../../db/testimonials.json";

import {
  BOOKING_URL,
  EMAIL_DOMAIN,
  EMAIL_USER,
  SERVICES,
  SERVICE_AREA_TEXT,
  isPlaceholder,
} from "../data/site";
import { CASE_STUDIES } from "../data/case-studies";
import { FAQ, SHOW_FAQ } from "../data/faq";

const STEPS = [
  {
    name: "Discover",
    text: "We start with conversation. I learn what the real problems are before anyone talks about solutions.",
  },
  { name: "Deliver", text: "I come up with a solution and build it." },
  {
    name: "Refine",
    text: "I keep tuning the strategy until you're getting the results you want.",
  },
];

// Only numbers already shown on the home page project cards; two have case studies
const caseStudy = (slug: string) =>
  CASE_STUDIES.find((study) => study.slug === slug)!;
const RESULTS = [
  {
    text: caseStudy("law-firm-headless-migration").result,
    href: "/work/law-firm-headless-migration",
    name: "law firm",
  },
  { text: "A life coach's site cut hosting from $240 a year to $16." },
  {
    text: caseStudy("hall-of-fame-rebuild").result,
    href: "/work/hall-of-fame-rebuild",
    name: "Hall of Fame",
  },
];

// FAQPage markup only includes answered questions, so placeholders never reach search results
const answered = SHOW_FAQ
  ? FAQ.filter((item) => !isPlaceholder(item.answer))
  : [];
const faqPage = answered.length
  ? [
      {
        "@type": "FAQPage",
        "@id": "https://tumulty.me/work-with-me#faq",
        mainEntity: answered.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      },
    ]
  : [];

// First three by order; cardQuote is the shorter excerpt when one exists
const featured = [...testimonials]
  .sort((a, b) => a.order - b.order)
  .slice(0, 3)
  .map((t) => ({ ...t, quote: t.cardQuote ?? t.statement }));

const focusRing =
  "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-800";
const sectionHeading = "text-2xl text-emerald-800 font-bold mb-4";
const bodyText = "text-emerald-800 playfair-display";
---

<Layout
  title="Work with Peter Tumulty | Product Management & Engineering"
  description="Work with Peter Tumulty on long-term contracts: project planning, technical roadmaps, strategy, AI modernization, engineering, automation, and cloud."
  breadcrumbs={[{ name: "Work with me", path: "/work-with-me" }]}
  jsonLd={faqPage}
>
  <div class="w-full pl-3 pr-4 mt-2 mb-8">
    <div
      class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-8"
    >
      <!-- Tighter letter-spacing below 640px so the heading stays on one line at 375px -->
      <h1
        class="text-4xl text-emerald-800 tracking-[3px] sm:tracking-[8px] font-bold"
      >
        Work with me
      </h1>
    </div>

    <!-- Each section is a labelled Tab stop so keyboard and screen reader users can move section by section -->
    <div class="bg-white border rounded-lg p-6 shadow-sm flex flex-col gap-10">
      <section
        aria-labelledby="intro-heading"
        tabindex="0"
        class="flex flex-col gap-6"
      >
        <h2 id="intro-heading" class={`text-lg ${bodyText}`}>
          Software engineer and technical product manager for long-term contract
          work.
        </h2>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={BOOKING_URL}
            target="_blank"
            rel="noopener noreferrer"
            class={`inline-block no-underline rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-5 py-3 ${focusRing}`}
          >
            Book an intro call<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a
            data-email-user={EMAIL_USER}
            data-email-domain={EMAIL_DOMAIN}
            hidden
            class={`text-emerald-800 font-semibold underline ${focusRing}`}
            >Or email me</a
          >
          <noscript>
            <span class="text-emerald-800"
              >Or email me: peter at tumulty dot me</span
            >
          </noscript>
        </div>
        <p class={bodyText}>
          I take ownership of a business's technology, from the public website
          and internal apps to the cloud they run on. I build what's missing and
          get engineering teams onto better tooling so they ship faster. I focus
          on outcomes over outputs, and every project is driven by one of two
          goals: cutting costs or making the team more efficient. As an
          independent consultant, I brought down what clients paid to run their
          sites, and as an engineer on a large team, I helped us deliver ahead
          of schedule.
        </p>
      </section>

      <section aria-labelledby="services-heading" tabindex="0">
        <h3 id="services-heading" class={sectionHeading}>What I do</h3>
        <ul
          class={`list-disc pl-5 sm:columns-2 gap-x-10 space-y-2 ${bodyText}`}
        >
          {SERVICES.map((service) => <li>{service}</li>)}
        </ul>
      </section>

      <section aria-labelledby="area-heading" tabindex="0">
        <h3 id="area-heading" class={sectionHeading}>Where I work</h3>
        <p class={bodyText}>{SERVICE_AREA_TEXT}.</p>
      </section>

      <section aria-labelledby="results-heading" tabindex="0" data-track-view="results">
        <h3 id="results-heading" class={sectionHeading}>Results</h3>
        <ul class="grid gap-4 md:grid-cols-3">
          {
            RESULTS.map((result) => (
              <li class="border-[0.5px] border-stone-200 rounded-lg shadow-md p-4 flex flex-col items-start gap-3">
                <p class={bodyText}>{result.text}</p>
                {result.href && (
                  <a
                    href={result.href}
                    class={`text-emerald-800 font-semibold underline ${focusRing}`}
                  >
                    Read the case study
                    <span class="sr-only">: {result.name}</span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="process-heading" tabindex="0">
        <h3 id="process-heading" class={sectionHeading}>
          How an engagement works
        </h3>
        <ol class={`list-decimal pl-5 flex flex-col gap-2 ${bodyText}`}>
          {
            STEPS.map((step) => (
              <li>
                <strong>{step.name}.</strong> {step.text}
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="testimonials-heading" tabindex="0">
        <h3 id="testimonials-heading" class={sectionHeading}>Testimonials</h3>
        <ul class="flex flex-col gap-4">
          {
            featured.map((testimonial) => (
              <li class="border-[0.5px] border-stone-200 rounded-lg shadow-md p-4">
                <figure>
                  <blockquote class={`mb-3 ${bodyText}`}>
                    “{testimonial.quote}”
                  </blockquote>
                  <figcaption>
                    <span class="block text-lg text-emerald-700 font-bold">
                      {testimonial.name}
                    </span>
                    <span class="block text-sm text-stone-600 font-semibold playfair-display">
                      {testimonial.company}
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </section>

      {
        SHOW_FAQ && (
          <section aria-labelledby="faq-heading" tabindex="0">
            <h3 id="faq-heading" class={sectionHeading}>Questions</h3>
            <div class="flex flex-col gap-5">
              {
                FAQ.map((item) => (
                  <div>
                    <h4 class="text-lg text-emerald-800 font-bold mb-1">
                      {item.question}
                    </h4>
                    <p
                      class={
                        isPlaceholder(item.answer)
                          ? "border border-dashed border-amber-500 bg-amber-50 text-amber-900 rounded-lg px-4 py-3 playfair-display"
                          : bodyText
                      }
                    >
                      {item.answer}
                    </p>
                  </div>
                ))
              }
            </div>
          </section>
        )
      }

      <section
        aria-labelledby="contact-heading"
        tabindex="0"
        class="flex flex-col gap-4"
      >
        <h3 id="contact-heading" class={sectionHeading}>Get in touch</h3>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={BOOKING_URL}
            target="_blank"
            rel="noopener noreferrer"
            class={`inline-block no-underline rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-5 py-3 ${focusRing}`}
          >
            Book an intro call<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a
            data-email-user={EMAIL_USER}
            data-email-domain={EMAIL_DOMAIN}
            hidden
            class={`text-emerald-800 font-semibold underline ${focusRing}`}
            >Or email me</a
          >
          <noscript>
            <span class="text-emerald-800"
              >Or email me: peter at tumulty dot me</span
            >
          </noscript>
        </div>
      </section>
    </div>
  </div>
</Layout>
