---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";

const posts = await getCollection("words", ({ data }) => data.published);
const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Words | Peter Tumulty"
  description="Notes on software engineering, technical product management, and AI-driven modernization."
>
  <div class="w-full pl-3 pr-4 mt-2 mb-8">
    <div
      class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-8"
    >
      <h1
        style="letter-spacing: 8px"
        class="text-4xl text-emerald-800 tracking-wider font-bold"
      >
        Words
      </h1>
    </div>
    <div class="flex flex-col w-full">
      {sorted.map((post, index) => (
        <PostCard
          title={post.data.title}
          tagLine={post.data.tagLine}
          description={post.data.summary}
          href={`/words/${post.slug}`}
          index={index}
        />
      ))}
    </div>
  </div>
</Layout>
