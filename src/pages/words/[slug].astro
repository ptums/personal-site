---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { SITE_URL } from "../../data/site";
import { IDS } from "../../data/structured-data";

export async function getStaticPaths() {
  const posts = await getCollection("words", ({ data }) => data.published);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Keep the <title> under 60 characters: add the name when it fits, else the title alone,
// else the post's seoTitle
const fullTitle = `${post.data.title} | Peter Tumulty`;
const pageTitle =
  post.data.seoTitle ?? (fullTitle.length <= 60 ? fullTitle : post.data.title);

const description = post.data.seoDescription ?? post.data.summary;
const postUrl = new URL(`/words/${post.slug}`, SITE_URL).href;
const blogPosting = {
  "@type": "BlogPosting",
  "@id": `${postUrl}#article`,
  headline: post.data.title,
  description,
  datePublished: post.data.date.toISOString().slice(0, 10),
  url: postUrl,
  mainEntityOfPage: { "@id": `${postUrl}#webpage` },
  author: { "@id": IDS.person },
  publisher: { "@id": IDS.person },
  inLanguage: "en",
};

// Dates are parsed as UTC midnight; format in UTC so they don't shift a day
const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title={pageTitle}
  description={description}
  breadcrumbs={[
    { name: "Words", path: "/words" },
    { name: post.data.title, path: `/words/${post.slug}` },
  ]}
  jsonLd={[blogPosting]}
>
  <div class="w-full pl-3 pr-4 mt-2 mb-8">
    <div class="bg-white border rounded-lg p-6 shadow-sm">
      <article class="post-content">
        <h1>{post.data.title}</h1>
        <time
          datetime={post.data.date.toISOString().slice(0, 10)}
          class="text-sm text-gray-500 font-semibold playfair-display"
        >
          {formattedDate}
        </time>
        <Content />
      </article>
    </div>
  </div>
</Layout>
