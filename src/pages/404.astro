---
import Layout from "../layouts/Layout.astro";

const focusRing =
  "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-800";
---

<Layout
  title="Page not found | Peter Tumulty"
  description="The page you were looking for could not be found."
>
  <div class="w-full pl-3 pr-4 mt-2 mb-8">
    <h1
      class="text-4xl text-emerald-800 tracking-[3px] sm:tracking-[8px] font-bold mb-8"
    >
      Page not found
    </h1>
    <div class="bg-white border rounded-lg p-6 shadow-sm flex flex-col gap-6">
      <p class="text-lg text-emerald-800 playfair-display">
        Sorry, the page you were looking for doesn't exist or has moved.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href="/"
          class={`inline-block rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-5 py-3 ${focusRing}`}
        >
          Go to the home page
        </a>
        <a
          href="/work-with-me"
          class={`text-emerald-800 font-semibold underline ${focusRing}`}
        >
          Work with me
        </a>
      </div>
    </div>
  </div>
</Layout>
