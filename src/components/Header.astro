---
import Nav from "./Nav.astro";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const EMAIL = "peter@tumulty.me";
// These pages render Nav beside their own heading instead
const hasOwnNav = ["/", "/words", "/testimonials"].includes(
  pathname.replace(/\/$/, "") || "/",
);
---

<header class="w-full flex flex-row items-center justify-between h-16 pr-4">
  <div class="flex items-center min-w-0 shrink">
    <a href="/">
      <img
        src="/images/badge.svg"
        alt="Tumulty Web Services"
        width="62"
        height="62"
      />
    </a>
    <a href={`mailto:${EMAIL}`}>
      <span class="text-emerald-800 hover:underline">{EMAIL}</span>
    </a>
  </div>
  {!hasOwnNav && <Nav pathname={pathname} />}
</header>
