---
interface Props {
  title: string;
  tagLine?: string;
  description: string;
  href: string;
  index: number;
}

const { title, tagLine, description, href, index } = Astro.props;
const delay = index * 0.15;
---

<a
  href={href}
  class="bg-white border-[0.5px] border-stone-200 rounded-lg shadow-md mb-6 last:mb-0 p-4 cursor-pointer flex flex-col justify-center text-left fade-in-up"
  style={`animation-delay: ${delay}s`}
>
  <p class="text-xl text-emerald-700 font-semibold mb-1">{title}</p>
  {tagLine && (
    <p class="text-sm text-gray-500 font-semibold mb-4 playfair-display">{tagLine}</p>
  )}
  <p class="text-sm text-emerald-800 font-normal playfair-display">{description}</p>
</a>
