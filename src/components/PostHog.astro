---
// PostHog analytics (TWS-71). Rendered only when ENABLE_POSTHOG is true in src/data/site.ts.
// Settings match /privacy: no cookies (server-side daily hash), no person profiles,
// page views, clicks, and named events for the booking and email links.
const key = import.meta.env.PUBLIC_POSTHOG_KEY;
const host = import.meta.env.PUBLIC_POSTHOG_HOST ?? "https://us.i.posthog.com";
---

{
  key && (
    <posthog-config data-key={key} data-host={host} hidden></posthog-config>
  )
}

<script>
  // Astro bundles this script on every page, even when the component is not rendered.
  // So the PostHog library is loaded with a dynamic import, only when the config element
  // exists (flag on and key set). With the flag off, pages load only these few lines.
  const config = document.querySelector("posthog-config") as HTMLElement | null;
  if (config?.dataset.key) {
    const { default: posthog } = await import("posthog-js");
    posthog.init(config.dataset.key, {
      api_host: config.dataset.host,
      cookieless_mode: "always",
      person_profiles: "never",
      capture_pageview: true,
      autocapture: true,
    });

    // Named events for the two actions that matter most (the funnel in TWS-71)
    document.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest("a");
      if (!link) return;
      if (link.href.startsWith("https://cal.com/")) {
        posthog.capture("booking_link_clicked", { page: location.pathname });
      } else if (link.hasAttribute("data-email-user")) {
        posthog.capture("email_link_clicked", { page: location.pathname });
      }
    });
  }
</script>
