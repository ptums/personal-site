---
// PostHog analytics (TWS-71). Rendered only when ENABLE_POSTHOG is true in src/data/site.ts.
// Settings match /privacy: no cookies or browser storage (cookieless mode), no person profiles,
// page views, clicks, and named events for the booking and email links.
const key = import.meta.env.PUBLIC_POSTHOG_KEY;
const host = import.meta.env.PUBLIC_POSTHOG_HOST ?? "https://us.i.posthog.com";
---

{
  key && (
    <posthog-config data-key={key} data-host={host} hidden></posthog-config>
  )
}

<script>
  // Astro bundles this script on every page, even when the component is not rendered.
  // So the PostHog library is loaded with a dynamic import, only when the config element
  // exists (flag on and key set). With the flag off, pages load only these few lines.
  const config = document.querySelector("posthog-config") as HTMLElement | null;
  if (config?.dataset.key) {
    const { default: posthog } = await import("posthog-js");
    // Privacy options as in the parks finder (web/src/analytics.ts), but cookieless mode
    // instead of memory persistence, so unique visitors can be counted.
    // Option names checked against @posthog/types 1.416 (posthog-js 1.435).
    posthog.init(config.dataset.key, {
      api_host: config.dataset.host,
      // No cookies or browser storage. PostHog makes a daily-salted hash ID on its servers,
      // so a visit can be followed across pages for one day. Needs "Cookieless server hash mode" on.
      cookieless_mode: "always",
      person_profiles: "never",
      respect_dnt: true,
      disable_session_recording: true,
      capture_pageview: true,
      capture_pageleave: false,
      // Only clicks and the named events: turn off what the remote config could switch on
      capture_performance: false,
      capture_heatmaps: false,
      capture_dead_clicks: false,
      capture_exceptions: false,
      rageclick: false,
      disable_surveys: true,
      disable_product_tours: true,
      disable_conversations: true,
      disable_web_experiments: true,
      disable_external_dependency_loading: true,
      advanced_disable_flags: true,
      save_referrer: false,
      // PostHog also adds the IP on its servers; "Discard client IP data" covers that
      before_send: (event) => {
        if (event) delete event.properties.$ip;
        return event;
      },
      autocapture: {
        dom_event_allowlist: ["click"],
        element_allowlist: ["button", "a"],
      },
    });

    // One event when a tracked block (data-track-view) first scrolls into view, e.g. Results on /work-with-me
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const block = (entry.target as HTMLElement).dataset.trackView;
            posthog.capture(`${block}_viewed`, { page: location.pathname });
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.5 },
      );
      document.querySelectorAll("[data-track-view]").forEach((el) => observer.observe(el));
    }

    // Named events for the two actions that matter most (the funnel in TWS-71)
    document.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest("a");
      if (!link) return;
      if (link.href.startsWith("https://cal.com/")) {
        posthog.capture("booking_link_clicked", { page: location.pathname });
      } else if (link.hasAttribute("data-email-user")) {
        posthog.capture("email_link_clicked", { page: location.pathname });
      }
    });
  }
</script>
