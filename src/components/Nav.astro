---
interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

// On the home page the first link goes to the blog; everywhere else it goes home
const navigation = [
  pathname === "/"
    ? { name: "Words", href: "/blog" }
    : { name: "Home", href: "/" },
  { name: "Resume", href: "/images/PFT-Resume-2026.pdf" },
];
---

<nav>
  <ul class="flex items-center text-emerald-800">
    {navigation.map((link, i) => (
      <li class="flex items-center">
        {i > 0 && <span class="mx-2 text-emerald-300" aria-hidden="true">|</span>}
        <a
          href={link.href}
          class={`hover:underline ${link.href !== "/" && pathname.startsWith(link.href) ? "underline" : ""}`}
        >
          {link.name}
        </a>
      </li>
    ))}
  </ul>
</nav>
