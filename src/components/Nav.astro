---
interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const current = pathname.replace(/\/$/, "") || "/";

// Every page except the one being viewed; blog posts still link back to /blog
const navigation = [
  { name: "Home", href: "/" },
  { name: "Words", href: "/blog" },
  { name: "Testimonials", href: "/testimonials" },
  { name: "Resume", href: "/images/PFT-Resume-2026.pdf" },
].filter((link) => link.href !== current);
---

<nav>
  <ul class="flex items-center text-emerald-800">
    {navigation.map((link, i) => (
      <li class="flex items-center">
        {i > 0 && <span class="mx-2 text-emerald-300" aria-hidden="true">|</span>}
        <a
          href={link.href}
          class={`hover:underline ${link.href !== "/" && pathname.startsWith(link.href) ? "underline" : ""}`}
        >
          {link.name}
        </a>
      </li>
    ))}
  </ul>
</nav>
