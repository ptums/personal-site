---
interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const current = pathname.replace(/\/$/, "") || "/";

const navigation = [
  { name: "Home", href: "/" },
  { name: "Words", href: "/words" },
  { name: "Testimonials", href: "/testimonials" },
  { name: "Work with me", href: "/work-with-me" },
];

// Home matches only itself; other links also match their sub-pages (e.g. posts under /words)
const isCurrent = (href: string) =>
  href === "/" ? current === "/" : current === href || current.startsWith(`${href}/`);
---

<!-- On small screens the links wrap as whole items, without the | separators -->
<nav>
  <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 sm:gap-x-0 text-emerald-800">
    {navigation.map((link, i) => (
      <li class="flex items-center whitespace-nowrap">
        {i > 0 && <span class="hidden sm:inline mx-2 text-emerald-300" aria-hidden="true">|</span>}
        {/* Every link is underlined. The current page gets a thicker emerald-600 underline
            (3.8:1 on white, meeting WCAG 1.4.11); aria-current also marks it for screen readers. */}
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? "page" : undefined}
          class={isCurrent(link.href) ? "decoration-2 decoration-emerald-600" : "decoration-emerald-300 hover:decoration-emerald-600"}
        >
          {link.name}
        </a>
      </li>
    ))}
  </ul>
</nav>
