CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_MANAGEMENT_API_PERSONAL_ACCESS_TOKEN=

# Optional: provide explicit GraphQL endpoint instead of SPACE_ID + ENVIRONMENT.
# CONTENTFUL_GRAPHQL_API_URL=https://graphql.contentful.com/content/v1/spaces/<space-id>/environments/<environment>

# PostHog analytics (TWS-71). Set in Vercel for production; see docs/analytics.md.
PUBLIC_POSTHOG_KEY=
# Only for an EU project. Default: https://us.i.posthog.com
# PUBLIC_POSTHOG_HOST=
